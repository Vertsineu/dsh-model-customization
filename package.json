{
  "name": "dsh-model-customization",
  "description": "dsh web 插件「模型定制工作台」: per-route/per-model model customization UI (input modalities, thinking levels, extra request params) over the llm-pi-ai / llm-deepseek settings sections",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "llm",
    "settings",
    "vllm",
    "deepseek",
    "thinking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vertsineu/dsh-model-customization.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
